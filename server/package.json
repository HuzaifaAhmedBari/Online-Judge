{
  "name": "online-judge-server",
  "version": "1.0.0",
  "description": "Online Judge Platform - API Server",
  "main": "src/index.js",
  "scripts": {
    "dev": "powershell -NoProfile -Command \"$port = 4000; $listeners = Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction SilentlyContinue; if ($listeners) { $listeners | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { Stop-Process -Id $_ -Force } }; $env:PORT = $port; node --watch src/index.js\"",
    "start": "node src/index.js",
    "worker": "node src/worker.js",
    "worker:dev": "node --watch src/worker.js",
    "queue:clean": "node src/queue/cleanup.js",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.0.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "prisma": "^6.9.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "msgpackr-extract@3.0.4": true
  }
}
